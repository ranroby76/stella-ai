        "wasmtime-v39.0.1-x86_64-windows-c-api" STELLA_WASMTIME_DIR)

    stella_fetch(wasi-sdk "${_stella_wasisdk}/wasi-sdk-25.0-x86_64-windows.tar.gz"
        "ebd4868f95a6e764bf29283e3bdf54df0df3902a29737176da9c17da218b939b"
        "wasi-sdk-25.0-x86_64-windows" STELLA_WASI_SDK_DIR)

    stella_fetch(llvm-mingw "${_stella_mingw}/llvm-mingw-20260922-ucrt-x86_64.zip"
        "e3ad77d117a4bea19a7a3b333341824d79a5a371004a10e25b8504e7b3047666"
        "llvm-mingw-20260922-ucrt-x86_64" STELLA_LLVM_MINGW_DIR)
elseif(UNIX AND NOT APPLE AND CMAKE_SYSTEM_PROCESSOR MATCHES "x86_64|AMD64")
