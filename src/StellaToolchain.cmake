# C:\workspace\Stella AI Studio\src\StellaToolchain.cmake
#
# The tools behind the live preview and Export, downloaded once into build/_deps:
#   Wasmtime 39.0.1 (C API): runs the plugin being built, live, in a sandbox;
#   wasi-sdk 25: the compiler that turns a plugin's C++ into WebAssembly;
#   llvm-mingw 20260922: the compiler that builds the exported plugin for Windows;
#   CLAP 1.2.10 and VST3 3.8.1 (pluginterfaces, MIT licensed): the plugin formats' headers.
# The compilers and headers ship with the studio, so users don't need anything installed.
#
# Sets STELLA_WASMTIME_DIR, STELLA_WASI_SDK_DIR, STELLA_LLVM_MINGW_DIR, STELLA_CLAP_DIR and
# STELLA_VST3_DIR, and writes StellaToolchainPaths.h into the build folder.

set(STELLA_DEPS_DIR "${CMAKE_BINARY_DIR}/_deps")
file(MAKE_DIRECTORY "${STELLA_DEPS_DIR}")

function(stella_fetch name url sha256 folder result_var)
    set(dir "${STELLA_DEPS_DIR}/${folder}")
    set(stamp "${STELLA_DEPS_DIR}/${name}.done")

    if(NOT EXISTS "${stamp}" OR NOT IS_DIRECTORY "${dir}")
        get_filename_component(archive_name "${url}" NAME)
        set(archive "${STELLA_DEPS_DIR}/${archive_name}")

        message(STATUS "Stella: downloading ${archive_name} (once)")
        file(DOWNLOAD "${url}" "${archive}" STATUS status TLS_VERIFY ON EXPECTED_HASH SHA256=${sha256})
        list(GET status 0 code)

        if(NOT code EQUAL 0)
            message(FATAL_ERROR "Stella: couldn't download ${url}: ${status}")
        endif()

        message(STATUS "Stella: unpacking ${archive_name}")
        file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${STELLA_DEPS_DIR}")
        file(REMOVE "${archive}")

        if(NOT IS_DIRECTORY "${dir}")
            message(FATAL_ERROR "Stella: ${archive_name} didn't unpack to ${dir}")
        endif()

        file(WRITE "${stamp}" "${url}\n")
    endif()

    set(${result_var} "${dir}" PARENT_SCOPE)
endfunction()

set(_stella_wasmtime "https://github.com/bytecodealliance/wasmtime/releases/download/v39.0.1")
set(_stella_wasisdk  "https://github.com/WebAssembly/wasi-sdk/releases/download/wasi-sdk-25")
