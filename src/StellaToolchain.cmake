    stella_fetch(wasi-sdk "${_stella_wasisdk}/wasi-sdk-25.0-x86_64-linux.tar.gz"
        "52640dde13599bf127a95499e61d6d640256119456d1af8897ab6725bcf3d89c"
        "wasi-sdk-25.0-x86_64-linux" STELLA_WASI_SDK_DIR)

    stella_fetch(llvm-mingw "${_stella_mingw}/llvm-mingw-20260922-ucrt-ubuntu-22.04-x86_64.tar.xz"
        "bb7bb7654b33d5aa8712acb837c963b2e0c56352560c76105270a3268c665c21"
        "llvm-mingw-20260922-ucrt-ubuntu-22.04-x86_64" STELLA_LLVM_MINGW_DIR)
else()
    message(FATAL_ERROR "Stella: the live preview's tools are set up for Windows so far; macOS comes later.")
endif()

stella_fetch(clap "https://codeload.github.com/free-audio/clap/tar.gz/refs/tags/1.2.10"
    "58fdb977c6678859c15d57942378b651399178f49a3a8ecad1813b9f231dc096"
    "clap-1.2.10" STELLA_CLAP_DIR)

stella_fetch(vst3-pluginterfaces "https://codeload.github.com/steinbergmedia/vst3_pluginterfaces/tar.gz/refs/tags/v3.8.1_build_84"
    "19e88e225b6ecb4a3c429d3ff2fd511be9c6c8b8b1c7e86b05949b45c0553e2d"
    "vst3_pluginterfaces-3.8.1_build_84" _stella_vst3_interfaces)

# The headers are included as "pluginterfaces/...", so they need a folder of that name.
set(STELLA_VST3_DIR "${STELLA_DEPS_DIR}/vst3")

if(NOT EXISTS "${STELLA_VST3_DIR}/pluginterfaces/base/funknown.h")
    file(COPY "${_stella_vst3_interfaces}/" DESTINATION "${STELLA_VST3_DIR}/pluginterfaces")
endif()

# Where the compiler lives while developing, for WasmCompiler.cpp. Only rewritten when it
# changes, so it doesn't trigger rebuilds.
set(STELLA_GENERATED_DIR "${CMAKE_BINARY_DIR}/stella_generated")
file(WRITE "${STELLA_GENERATED_DIR}/StellaToolchainPaths.h.new"
     "// Generated by CMake: where the bundled compilers and headers are while developing.\n#pragma once\n#define STELLA_WASI_SDK_DIR \"${STELLA_WASI_SDK_DIR}\"\n#define STELLA_LLVM_MINGW_DIR \"${STELLA_LLVM_MINGW_DIR}\"\n#define STELLA_CLAP_INCLUDE_DIR \"${STELLA_CLAP_DIR}/include\"\n#define STELLA_VST3_INCLUDE_DIR \"${STELLA_VST3_DIR}\"\n")
configure_file("${STELLA_GENERATED_DIR}/StellaToolchainPaths.h.new" "${STELLA_GENERATED_DIR}/StellaToolchainPaths.h" COPYONLY)
